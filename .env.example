# Local development: all processes run on this Mac.
# For multiple Macs, use each process host's reachable LAN IP.
# Each server and its corresponding LFD must share a host.

# Server replicas
S1_HOST=127.0.0.1
S1_PORT=8080
S2_HOST=127.0.0.1
S2_PORT=8082
S3_HOST=127.0.0.1
S3_PORT=8083

# Replication settings. Use the same values on every machine. CLI flags override
# these; shell exports override .env.
#   active  -> Milestone #2: every replica handles every request, clients fan out
#              and discard duplicate replies.
#   passive -> Milestone #3: only the primary serves clients; backups receive
#              periodic state checkpoints and ignore client requests.
REPLICATION_MODE=passive

# Passive-replication only. The project guide designates "the first replica to
# show up" as primary; naming it explicitly here makes the demo reproducible
# across restarts. The Replication Manager (Milestone #4) replaces this static
# assignment.
PRIMARY_ID=S1

# Checkpoint frequency in Hz (checkpoints per second); the interval between
# checkpoints is 1 / CHECKPOINT_FREQ seconds. Only the primary uses it.
CHECKPOINT_FREQ=1

# Local fault detectors
LFD1_HOST=127.0.0.1
LFD1_PORT=8081
LFD2_HOST=127.0.0.1
LFD2_PORT=8084
LFD3_HOST=127.0.0.1
LFD3_PORT=8085

# GFD membership service; RM remains reserved for a future milestone.
GFD_HOST=127.0.0.1
GFD_PORT=9001
RM_HOST=127.0.0.1
RM_PORT=9002

# Heartbeat frequency and timeout are CLI options, not environment settings.
# Example: uv run lfd --id LFD1 --heartbeat_freq 2 --timeout 2
